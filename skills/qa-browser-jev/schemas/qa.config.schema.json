{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA Browser + Jev project configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "target",
    "contextFiles",
    "browser",
    "jev",
    "artifacts",
    "auth",
    "journeys"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseUrl",
        "environment",
        "allowedOrigins"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "environment": {
          "enum": [
            "local",
            "test",
            "preview",
            "staging"
          ]
        },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "contextFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "viewports"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "width",
              "height"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "width": {
                "type": "integer",
                "minimum": 240,
                "maximum": 8000
              },
              "height": {
                "type": "integer",
                "minimum": 240,
                "maximum": 8000
              }
            }
          }
        }
      }
    },
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "model",
        "maxCalls",
        "timeoutMs"
      ],
      "properties": {
        "mode": {
          "enum": [
            "required",
            "off"
          ]
        },
        "model": {
          "const": "typesafe-ai/jev"
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 15000
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "instructions"
      ],
      "properties": {
        "mode": {
          "enum": [
            "anonymous",
            "prepared-session"
          ]
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "actor",
          "requiredPath",
          "forbiddenRecovery",
          "expected",
          "verification",
          "viewports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "requiredPath": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbiddenRecovery": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "viewports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          }
        }
      }
    }
  },
  "description": "Schema para editor. Validações relacionais, dados sensíveis, origens e caminhos são adicionais em scripts/project.mjs."
}
